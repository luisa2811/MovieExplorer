# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# Keep Gson annotations and serialization
-keepattributes Signature
-keepattributes *Annotation*
-dontwarn com.google.gson.**
-keep class com.google.gson.** { *; }

# Keep DTO models for Gson deserialization
-keep class com.movieexplorer.data.remote.dto.** { *; }
-keepclassmembers class com.movieexplorer.data.remote.dto.** { *; }
